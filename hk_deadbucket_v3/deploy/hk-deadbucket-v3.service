[Unit]
Description=HK dead-bucket v3 (paper): HKO text-page trigger, dead buckets -> NO; public data, no keys
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntupolymarket3
WorkingDirectory=/home/ubuntupolymarket3/hk_deadbucket_v3
ExecStart=/home/ubuntupolymarket3/hkbot/.venv/bin/python -m v3 run --mode dry
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=20
Nice=5
MemoryMax=400M
StandardOutput=append:/home/ubuntupolymarket3/hk_deadbucket_v3/logs/bot.log
StandardError=append:/home/ubuntupolymarket3/hk_deadbucket_v3/logs/bot.log

[Install]
WantedBy=multi-user.target
