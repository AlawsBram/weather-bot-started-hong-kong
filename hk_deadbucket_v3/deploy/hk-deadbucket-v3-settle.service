[Unit]
Description=HK dead-bucket v3: settle

[Service]
Type=oneshot
User=ubuntupolymarket3
WorkingDirectory=/home/ubuntupolymarket3/hk_deadbucket_v3
ExecStart=/home/ubuntupolymarket3/hkbot/.venv/bin/python -m v3 settle
StandardOutput=append:/home/ubuntupolymarket3/hk_deadbucket_v3/logs/settle.log
StandardError=append:/home/ubuntupolymarket3/hk_deadbucket_v3/logs/settle.log
