[Unit]
Description=HK dead-bucket v3.2 (several connections per HKO server IP, first wins): text page polled over several keep-alive connections per HKO server IP (plus by name), first connection to show a new stamp fires, dead buckets -> NO (mode from deploy/.env V3_MODE, default dry)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntupolymarket3
WorkingDirectory=/home/ubuntupolymarket3/hk_deadbucket_v3_2_multi_conn
EnvironmentFile=-/home/ubuntupolymarket3/hk_deadbucket_v3_2_multi_conn/deploy/.env
ExecStart=/home/ubuntupolymarket3/hkbot/.venv/bin/python -m v3 run --mode ${V3_MODE}
Environment=PYTHONUNBUFFERED=1
Environment=V3_MODE=dry
Restart=always
RestartSec=20
Nice=5
MemoryMax=400M
StandardOutput=append:/home/ubuntupolymarket3/hk_deadbucket_v3_2_multi_conn/logs/bot.log
StandardError=append:/home/ubuntupolymarket3/hk_deadbucket_v3_2_multi_conn/logs/bot.log

[Install]
WantedBy=multi-user.target
